{
  "version": 1,
  "name": "reopen-awaiting-jobs",
  "description": "A session idle on background jobs keeps awaiting across a daemon-restart reopen that records awaiting_jobs (a downtime job_finished recorded just before it changes nothing), while a reopen without the flag ends it.",
  "steps": [
    {
      "event": {
        "seq": 1,
        "actor": "coordinator",
        "type": "session_started",
        "data": {}
      }
    },
    {
      "event": {
        "seq": 2,
        "actor": "coordinator",
        "type": "session_idle",
        "data": {
          "report": "Started two background builds; waiting on them.",
          "awaiting_jobs": true
        }
      }
    },
    {
      "event": {
        "seq": 3,
        "actor": "coordinator",
        "type": "job_finished",
        "data": {
          "id": "job_1",
          "kind": "bash",
          "label": "make one",
          "status": "done",
          "tail": "exit 0",
          "recovered": true
        }
      }
    },
    {
      "event": {
        "seq": 4,
        "actor": "coordinator",
        "type": "session_reopened",
        "data": {
          "surviving_jobs": ["job_2"],
          "awaiting_jobs": true
        }
      }
    },
    {
      "expect": {
        "cursor": 4,
        "phase": "idle",
        "awaiting_jobs": true
      }
    },
    {
      "reconnect": {}
    },
    {
      "expect": {
        "phase": "idle",
        "awaiting_jobs": true
      }
    },
    {
      "event": {
        "seq": 5,
        "actor": "coordinator",
        "type": "session_reopened",
        "data": {}
      }
    },
    {
      "expect": {
        "cursor": 5,
        "phase": "idle",
        "awaiting_jobs": false
      }
    }
  ]
}
