# secrets — never commit
ant-key
*.pem

# build artifacts (build to /tmp, not the source tree)
/ycc
/yccd
/ycc-spike
/cmd/*/ycc
/cmd/*/yccd

# session state + scratch; project docs configuration is committed
.ycc/*
!.ycc/config.toml
scratch/
lsp.webp

# iOS client (clients/ios): generated project + SPM/Xcode build detritus
clients/ios/*.xcodeproj
clients/ios/App/Info.plist
clients/ios/**/xcuserdata/
# scratch drop point for UI-review screenshots copied off a Mac/phone
clients/ios/screenshots/
clients/ios/**/.build/
clients/ios/**/.swiftpm/
clients/ios/**/Package.resolved
.DS_Store

# web client (clients/web): npm install output; the built bundle lives in internal/web/dist
clients/web/node_modules/
